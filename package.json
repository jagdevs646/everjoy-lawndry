{
  "name": "everjoy-lawndry",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts --demo --port 3001",
    "dev:web": "vite --host",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "demo": "vite build && tsx server/index.ts --demo",
    "test": "vitest run",
    "app:build": "tsc --noEmit && vite build --mode app && cap sync",
    "app:apk": "node scripts/build-apk.mjs",
    "app:apk:release": "node scripts/build-apk.mjs --release",
    "app:aab": "node scripts/build-apk.mjs --bundle",
    "app:ios": "tsc --noEmit && vite build --mode app && cap sync ios"
  },
  "type": "module",
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "html5-qrcode": "^2.3.8",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@electric-sql/pglite": "^0.6.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
